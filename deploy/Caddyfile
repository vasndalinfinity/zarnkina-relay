# Relay API + SSE. Long-lived streams need no buffering and no idle timeouts.
zarnkina-relay.hostless.app {
	encode zstd gzip

	@stream path /v1/chat/completions
	handle @stream {
		reverse_proxy relay:8080 {
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
				dial_timeout 10s
			}
		}
	}

	handle {
		reverse_proxy relay:8080 {
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 3
		}
		format console
	}
}
