# Copy to deploy/.env on the server. Never commit real values.
# `deploy/bootstrap.sh` generates VAULT_KEY locally from D:\zarnkina-relay\.env
NODE_ENV=production
PORT=8080

# Opens the encrypted vault (pool keys) and the sealed routing table.
VAULT_KEY=

# Google sign-in exchange (secret never ships in the desktop binary).
GOOGLE_CLIENT_ID=818723996932-mpabto4q6tbndd7q8uj65mov8aiumjrn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Admin panel password.
ADMIN_SECRET=

# Neon Postgres (state persistence).
DATABASE_URL=

# Token signing; falls back to VAULT_KEY when empty.
SESSION_SECRET=
